# cafce の環境変数テンプレート
#
# 使い方:
#   cp .env.example .env
#   set -a; . ./.env; set +a
#
# cafce 自体は .env を読まない（dotenv 系の依存を入れていない）ので、上記のように
# shell 側で明示的に読み込むこと。.env は .gitignore 済み。
#
# 注意: 下の [A] と [B] は同時に有効化できない（同じ変数名を別の用途で使うため）。
# 両方を使い分けたい場合は .env.aws / .env.rustfs のように別ファイルに分けて
# source し分けること。


# ===========================================================================
# [A] AWS 疎通テスト用
#     cargo test aws_integration -- --ignored --nocapture --test-threads=1
# ===========================================================================
#
# !! このセクションの値はすべて「例」であって、実在するリソースではない。!!
# バケット名もロール ARN も、自分の AWS アカウントに実在するものへ必ず置き換えること。
# 置き換え忘れると NoSuchBucket や AssumeRole("service error") で落ちる。
#
# バケットとロールは事前に作成しておく必要がある。テストは create_bucket を
# 呼ばないし、cafce-test-user 相当の絞られた権限では s3:CreateBucket も
# IAM 系の操作も実行できないため、管理者権限のあるプロファイルで用意すること。
#
# 3 本のテストが必要とする変数:
#
#   変数                    static  assume_role  profile
#   ---------------------------------------------------
#   CAFCE_AWS_ACCESS_KEY      o          o          -
#   CAFCE_AWS_SECRET_KEY      o          o          -
#   CAFCE_AWS_REGION          o          o          o
#   CAFCE_TEST_BUCKET         o          o          o
#   CAFCE_AWS_ROLE_ARN        -          o          -
#   CAFCE_AWS_PROFILE         -          -          o
#
# 各テストは Env::new()（プロセス全体の環境変数）ではなく Env::new_for_test(...) を
# 使って明示的に組み立てるため、例えば CAFCE_AWS_ROLE_ARN が設定されたままでも
# static credentials のテストが AssumeRole 分岐に化けることはない。
# つまりこのセクションは全部まとめて設定しておいてよい。

# IAM ユーザーのアクセスキー ID / シークレットアクセスキー。
# static credentials テストの本体であり、AssumeRole テストのソースクレデンシャルでもある。
#
# 空文字を設定すると std::env::var は Ok("") を返すため、テスト側の
# 「環境変数〜が設定されていません」という親切な panic が出ずに、不透明な
# AWS 認証エラーになる。使わない変数は空にせず行ごとコメントアウトすること。
CAFCE_AWS_ACCESS_KEY=AKIAXXXXXXXXXXXXXXXX
CAFCE_AWS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# テスト対象バケットのリージョン。
CAFCE_AWS_REGION=ap-northeast-1

# テスト専用に用意した「既存の」S3 バケット名。
# テストは create_bucket / delete_bucket を呼ばない（IAM ポリシーに作成・削除権限が
# 無い前提）ので、事前に作っておくこと。オブジェクトは put -> get -> delete される。
#
# アプリ本体が使う CAFCE_AWS_BUCKET とは別の変数名である点に注意。
CAFCE_TEST_BUCKET=REPLACE-ME-your-test-bucket

# aws_assume_role_smoke_test 用。上の IAM ユーザーから AssumeRole できるロールの ARN。
CAFCE_AWS_ROLE_ARN=arn:aws:iam::REPLACE-ME-account-id:role/REPLACE-ME-role-name

# aws_profile_smoke_test 用。~/.aws/config・~/.aws/credentials に事前設定しておく
# プロファイル名。cafce はこのプロファイルの中身を読まず、名前を SDK に渡して
# credential 解決を委ねるだけなので、プロファイル自体の設定は AWS CLI 側の作法に従う。
CAFCE_AWS_PROFILE=cafce-test-profile


# ===========================================================================
# [B] ローカル RustFS に対して cafce バイナリを実行する用
#     docker compose up -d してから使う
# ===========================================================================
#
# RustFS の統合テスト（cargo test rustfs_integration / --test probe_integration）は
# 接続情報をテスト内にハードコードしているので、これらの変数は不要。
# ここは `cargo run -- probe cafce.toml` のように実バイナリを手で叩くとき用。
#
# 値は docker-compose.yml の RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY と揃えること。

#CAFCE_AWS_SERVER_ADDRESS=localhost:9000
#CAFCE_AWS_ACCESS_KEY=cafce-dev-access-key
#CAFCE_AWS_SECRET_KEY=cafce-dev-secret-key
#CAFCE_AWS_INSECURE=true
#CAFCE_AWS_BUCKET=cafce-dev

# RustFS はバケットを自動作成しないので、一度だけ作っておく:
#   aws --endpoint-url http://localhost:9000 s3 mb s3://cafce-dev


# ===========================================================================
# [C] アプリ本体が読むその他の変数（省略可）
#     詳細は README.md の "Environment variables" を参照
# ===========================================================================

# S3 オブジェクトキーの前に付くプレフィックス。末尾のスラッシュは正規化される。
# 最終的なキーは {bucket}/{prefix?}/{project}/{cache_key} になる。
#CAFCE_S3_PREFIX=

# 一時クレデンシャルを直接渡す場合のセッショントークン。
#CAFCE_AWS_SESSION_TOKEN=

# AssumeRole 時のセッション名。省略時は "cafce-session"。
#CAFCE_AWS_ROLE_SESSION_NAME=cafce-session

# アドレッシング方式の明示指定（true: path-style / false: virtual-hosted）。
# 省略時は自動判定で、amazonaws.com 以外のエンドポイントなら path-style になる。
#CAFCE_AWS_FORCE_PATH_STYLE=

# env_logger のフィルタ。現状 cafce 本体に log:: 呼び出しが無いため実質 no-op。
#RUST_LOG=debug
